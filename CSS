* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

:root {
  font-family: "Segoe UI", Arial, sans-serif;
  color: #202438;
  background: #f3f4fa;
}

body {
  min-height: 100vh;
}

.topo {
  background: #3920a8;
  color: white;
  padding: 26px max(20px, calc((100% - 1200px) / 2));
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
}

.topo h1 {
  font-size: 1.7rem;
  margin-bottom: 5px;
}

.topo p {
  color: #e1dcff;
}

.status {
  background: #ffffff22;
  border: 1px solid #ffffff55;
  border-radius: 20px;
  padding: 8px 12px;
  font-size: 0.85rem;
}

.menu {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 6px;
  background: white;
  padding: 12px;
  border-bottom: 1px solid #e1e3ef;
}

.aba {
  padding: 11px 16px;
  border: none;
  border-radius: 8px;
  background: transparent;
  color: #42445b;
  font-size: 0.95rem;
  cursor: pointer;
}

.aba:hover,
.aba.ativa {
  background: #eeeaff;
  color: #3920a8;
}

.container {
  max-width: 1200px;
  margin: 28px auto;
  padding: 0 20px;
  min-height: 60vh;
}

.painel {
  background: white;
  padding: 26px;
  border: 1px solid #e5e6f0;
  border-radius: 16px;
  box-shadow: 0 8px 25px #2024380a;
}

.painel h2 {
  margin-bottom: 8px;
  font-size: 1.45rem;
}

.painel h3 {
  margin: 28px 0 14px;
  font-size: 1.1rem;
}

.subtitulo {
  color: #70748b;
  margin-bottom: 20px;
}

.escondido {
  display: none !important;
}

.resumos {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
  margin: 24px 0;
}

.resumo {
  background: #f8f7ff;
  border: 1px solid #e9e4ff;
  padding: 20px;
  border-radius: 12px;
}

.resumo span {
  display: block;
  color: #666981;
  margin-bottom: 10px;
}

.resumo strong {
  display: block;
  font-size: 1.5rem;
  color: #3920a8;
  overflow-wrap: anywhere;
}

.formulario {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
  margin: 22px 0;
}

label {
  display: flex;
  flex-direction: column;
  gap: 7px;
  font-size: 0.93rem;
  font-weight: 600;
  color: #3c4057;
}

input,
select {
  width: 100%;
  min-width: 0;
  padding: 12px;
  border: 1px solid #d7d9e6;
  border-radius: 8px;
  background: white;
  color: #202438;
  font: inherit;
  font-weight: 400;
}

input:focus,
select:focus {
  outline: 2px solid #b9adff;
  border-color: #7359e8;
}

.botao {
  padding: 12px 18px;
  border: none;
  border-radius: 8px;
  font: inherit;
  font-weight: 600;
  cursor: pointer;
  align-self: end;
}

.primario {
  background: #5136c7;
  color: white;
}

.primario:hover {
  background: #3920a8;
}

.secundario {
  background: #ececf4;
  color: #33364c;
}

.botao:disabled {
  opacity: 0.6;
  cursor: wait;
}

.tabela-conteiner {
  width: 100%;
  overflow-x: auto;
  border: 1px solid #e6e7ef;
  border-radius: 10px;
}

table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
  font-size: 0.92rem;
}

th,
td {
  padding: 13px 14px;
  border-bottom: 1px solid #e9eaf2;
  white-space: nowrap;
}

th {
  background: #f7f6fc;
  color: #4b4e65;
  font-weight: 700;
}

tbody tr:last-child td {
  border-bottom: none;
}

tbody tr:hover {
  background: #faf9ff;
}

.mensagem {
  display: none;
  padding: 13px 16px;
  border-radius: 9px;
  margin-bottom: 18px;
  line-height: 1.5;
}

.mensagem.sucesso {
  display: block;
  color: #17653c;
  background: #e7f7ed;
  border: 1px solid #b8e7c8;
}

.mensagem.erro {
  display: block;
  color: #9c2525;
  background: #fff0f0;
  border: 1px solid #f0c5c5;
}

.campo-filtro {
  max-width: 500px;
  margin: 20px 0;
}

.dados-cliente {
  margin: 18px 0;
  padding: 18px;
  background: #f8f7ff;
  border: 1px solid #e5e0ff;
  border-radius: 10px;
  line-height: 1.9;
}

.dados-cliente strong {
  color: #3920a8;
}

.filtros {
  display: flex;
  flex-wrap: wrap;
  align-items: end;
  gap: 14px;
  margin: 20px 0;
}

.filtros label {
  min-width: 180px;
}

.aviso {
  margin-top: 16px;
  padding: 13px;
  background: #fff8e6;
  border-radius: 8px;
  color: #795b16;
  line-height: 1.5;
}

footer {
  text-align: center;
  padding: 24px 15px;
  color: #777b90;
  font-size: 0.85rem;
}

@media (max-width: 760px) {
  .topo {
    align-items: flex-start;
    flex-direction: column;
  }

  .resumos {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .formulario {
    grid-template-columns: 1fr;
  }

  .painel {
    padding: 18px;
  }

  .container {
    padding: 0 12px;
    margin-top: 16px;
  }
}

@media (max-width: 400px) {
  .resumos {
    grid-template-columns: 1fr;
  }
}
