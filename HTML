
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sistema Empresarial de Vendas</title>
  <link rel="stylesheet" href="main.css">
  <script src="main.js" defer></script>
</head>
<body>
  <header>
    <h1>Sistema de Vendas</h1>
    <p>Controle empresarial</p>
  </header>

  <nav>
    <button data-pagina="inicio">Início</button>
    <button data-pagina="clientes">Clientes</button>
    <button data-pagina="produtos">Produtos</button>
    <button data-pagina="pedidos">Pedidos</button>
    <button data-pagina="relatorios">Relatórios</button>
  </nav>

  <main>
    <section id="inicio" class="pagina">
      <h2>Painel principal</h2>
      <div class="resumos">
        <article class="cartao">
          <h3>Clientes</h3>
          <p id="total-clientes">0</p>
        </article>
        <article class="cartao">
          <h3>Produtos</h3>
          <p id="total-produtos">0</p>
        </article>
        <article class="cartao">
          <h3>Pedidos</h3>
          <p id="total-pedidos">0</p>
        </article>
        <article class="cartao">
          <h3>Faturamento</h3>
          <p id="faturamento">R$ 0,00</p>
        </article>
      </div>
      <h3>Pedidos recentes</h3>
      <div id="pedidos-recentes"></div>
    </section>

    <section id="clientes" class="pagina escondido">
      <h2>Cadastro de clientes</h2>
      <form id="form-cliente">
        <label for="nome-cliente">Nome completo</label>
        <input id="nome-cliente" required>

        <label for="telefone-cliente">Telefone</label>
        <input id="telefone-cliente" type="tel" required>

        <label for="email-cliente">E-mail</label>
        <input id="email-cliente" type="email" required>

        <button type="submit">Cadastrar cliente</button>
      </form>
      <div id="lista-clientes"></div>
    </section>

    <section id="produtos" class="pagina escondido">
      <h2>Cadastro de produtos</h2>
      <form id="form-produto">
        <label for="nome-produto">Nome do produto</label>
        <input id="nome-produto" required>

        <label for="preco-produto">Preço (R$)</label>
        <input id="preco-produto" type="number" min="0.01" step="0.01" required>

        <label for="estoque-produto">Quantidade em estoque</label>
        <input id="estoque-produto" type="number" min="0" step="1" required>

        <button type="submit">Cadastrar produto</button>
      </form>
      <div id="lista-produtos"></div>
    </section>

    <section id="pedidos" class="pagina escondido">
      <h2>Novo pedido</h2>
      <form id="form-pedido">
        <label for="cliente-pedido">Cliente</label>
        <select id="cliente-pedido" required></select>

        <label for="produto-pedido">Produto</label>
        <select id="produto-pedido" required></select>

        <label for="quantidade-pedido">Quantidade</label>
        <input id="quantidade-pedido" type="number" min="1" step="1" value="1" required>

        <button type="submit">Registrar pedido</button>
      </form>
      <h3>Histórico de pedidos</h3>
      <div id="lista-pedidos"></div>
    </section>

    <section id="relatorios" class="pagina escondido">
      <h2>Relatório de vendas</h2>
      <label for="data-inicial">Data inicial</label>
      <input id="data-inicial" type="date">

      <label for="data-final">Data final</label>
      <input id="data-final" type="date">

      <button id="filtrar-relatorio" type="button">Filtrar</button>
      <div class="resumos">
        <article class="cartao">
          <h3>Pedidos no período</h3>
          <p id="relatorio-pedidos">0</p>
        </article>
        <article class="cartao">
          <h3>Vendas no período</h3>
          <p id="relatorio-total">R$ 0,00</p>
        </article>
      </div>
      <div id="resultado-relatorio"></div>
    </section>

    <p id="mensagem" role="status"></p>
  </main>
</body>
</html>
